# BotFather'dan aldığın token
TELEGRAM_BOT_TOKEN=123456789:AAH...
# Manitanın chat id'si (README'de nasıl bulunacağı yazıyor)
TELEGRAM_CHAT_ID=987654321

# OwnTracks'in sunucuya girerken kullanacağı kullanıcı/şifre (kendin uydur)
HTTP_USER=ilker
HTTP_PASS=uzun-ve-tahmin-edilemez-bir-sifre

# Mesajlarda görünecek isim
NICK=Aşkın

# Bilinen yerler (isim + koordinat + metre cinsinden yarıçap)
PLACES=[{"name":"Ev","lat":41.0082,"lon":28.9784,"radius":200},{"name":"İş","lat":41.0431,"lon":29.0094,"radius":250}]

# İnce ayar (varsayılanlar genelde iyidir)
MOVE_THRESHOLD_M=700
ARRIVE_MINUTES=10
COOLDOWN_MINUTES=5
MAX_ACCURACY_M=150
PORT=8080
STATE_FILE=/data/durum.json
